{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "packageRules": [
    {
      "matchPackageNames": ["github.com/pilab-cloud/pibase"],
      "groupName": "Update pibase dependency",
      "schedule": ["every 3 days"],
      "enabled": true,
      "separateMajorMinor": false,
      "pin": false,
      "rangeStrategy": "update-lockfile"
    }
  ]
}
