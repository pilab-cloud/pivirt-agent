{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "repositories": [
    "pilab-cloud/hypervisor",
    "pilab-cloud/pibase",
    "pilab-cloud/director",
    "pilab-cloud/hades",
    "pilab-cloud/pivirt-agent"
  ],
  "packageRules": [
    {
      "matchPackageNames": ["github.com/pilab-cloud/pibase"],
      "groupName": "Update pibase dependency",
      "schedule": ["every 3 day"],
      "enabled": true,
      "separateMajorMinor": false,
      "pin": {
        "enabled": false
      },
      "rangeStrategy": "update-lockfile"
    }
  ],
  "customEnvVariables": {
    "GOPRIVATE": "go.pilab.hu/",
    "GONOSUMDB": "go.pilab.hu/",
    "GONOPROXY": "go.pilab.hu/"
  }
}
